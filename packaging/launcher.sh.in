#!/bin/sh
# Starts Sublime Music from @LIBDIR@ (generated by the Makefile, do not edit).
#
# A bundled package ships its Python dependencies in @LIBDIR@/vendor, which is put
# first on the path so that they are used instead of whatever the system has.
LIBDIR="@LIBDIR@"
if [ -d "$LIBDIR/vendor" ]; then
    PYTHONPATH="$LIBDIR/vendor:$LIBDIR${PYTHONPATH:+:$PYTHONPATH}"
else
    PYTHONPATH="$LIBDIR${PYTHONPATH:+:$PYTHONPATH}"
fi
export PYTHONPATH
exec @PYTHON@ -m sublime_music "$@"
